{
	"name": "@nebula-sdk/express",
	"version": "0.1.0",
	"description": "Express integration for Nebula device authentication",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"dev": "tsup src/index.ts --format esm,cjs --dts --watch",
		"test": "vitest run"
	},
	"dependencies": {
		"@nebula-sdk/core": "workspace:*",
		"@nebula-sdk/dashboard": "workspace:*",
		"@nebula-sdk/mongoose": "workspace:*",
		"express-rate-limit": "^8.7.3"
	},
	"peerDependencies": {
		"express": "^4.21.0 || ^5.0.0",
		"mongoose": "^8.0.0 || ^9.0.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"express": "^5.0.0",
		"mongoose": "^9.0.0",
		"typescript": "^5.9.0"
	}
}
