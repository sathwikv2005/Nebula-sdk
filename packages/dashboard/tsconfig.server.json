{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist/server",
		"rootDir": "./src/server",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/server/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
