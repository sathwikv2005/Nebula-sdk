{
	"name": "@nebula-sdk/dashboard",
	"version": "0.1.0",
	"description": "Web dashboard for Nebula device management",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/server/index.cjs",
	"module": "./dist/server/index.js",
	"types": "./dist/server/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"require": "./dist/server/index.cjs"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && tsup src/server/index.ts --format esm,cjs --dts --out-dir dist/server",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"react-router": "^7.0.0"
	},
	"peerDependencies": {
		"express": "^4.21.0 || ^5.0.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"express": "^5.0.0",
		"typescript": "^5.9.0",
		"vite": "^8.3.6",
		"vitest": "^4.0.0"
	}
}
