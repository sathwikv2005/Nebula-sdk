{
	"name": "@nebula-sdk/core",
	"version": "0.1.0",
	"description": "Core device authentication and management engine for Nebula",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
